# Xcode build output. Everything here is regenerated by a build.
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Swift Package Manager. Checkouts and compiled products of the local packages;
# Package.resolved is kept, because the versions a build used are worth having.
.build/
.xcbuild/
.swiftpm/

# Release artefacts. A built app belongs on a release page, not in the history.
dist/

# macOS
.DS_Store
